# Copy to apps/api/.env (or the repo root .env) and replace every CHANGE_ME.
DATABASE_URL=postgresql://m2s:CHANGE_ME@localhost:5432/m2s
# 32+ random characters, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=CHANGE_ME_LONG_RANDOM
PORT=3000

# Production HTTP / reverse-proxy tuning
# Express trust proxy (`loopback`, `1` for 1 hop behind nginx/caddy, `true`, or `false`).
TRUST_PROXY=loopback
# Override session cookie `Secure` flag (`true` / `false`). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
# Comma-separated browser origins allowed by CORS when serving API separately from the web app.
CORS_ORIGINS=
# Serve built apps/web/dist directly from the API server (`true` / `false`; auto-enabled in production).
SERVE_WEB_DIST=

# Document storage. Leave S3_BUCKET empty to use private local disk storage in STORAGE_DIR.
STORAGE_DIR=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional ClamAV daemon (`clamd`) TCP INSTREAM scanner. Built-in EICAR + PDF active-action guards always run.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Set to `false` to warn and allow built-in-clean files if CLAMAV_HOST is temporarily unreachable.
CLAMAV_STRICT=true

# Only for `npm run bootstrap-admin` (first SUPER_ADMIN). Remove after use.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Only for `npm run seed:demo` on a development machine (refused when NODE_ENV=production).
DEMO_PASSWORD=
