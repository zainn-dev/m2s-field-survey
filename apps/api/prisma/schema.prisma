generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SUPERVISOR
  VOLUNTEER
}

enum SurveyStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVE
  REJECT
  RETURN
}

enum DocStatus {
  UPLOADING
  SCANNING
  AVAILABLE
  QUARANTINED
  DELETED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id               String              @id @default(uuid())
  email            String              @unique
  mobile           String?             @unique
  name             String
  passwordHash     String
  role             Role
  active           Boolean             @default(true)
  targetHouseholds Int?
  lastActiveAt     DateTime?
  lastIp           String?
  lastIpLocation   String?
  lastGpsLat       Float?
  lastGpsLng       Float?
  lastGpsAccuracy  Float?
  lastGpsCapturedAt DateTime?
  lastLocationLabel String?
  /// Bumped on password change / disable so existing sessions are revoked.
  tokenVersion     Int                 @default(0)
  notificationsSeenAt DateTime?
  assignments      ClusterAssignment[]
  surveys          Survey[]
  reviews          ReviewAction[]
  uploadedDocs     Document[]          @relation("DocUploader")
  verifiedDocs     Document[]          @relation("DocVerifier")
  auditLogs        AuditLog[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model Cluster {
  id               String              @id @default(uuid())
  code             String              @unique
  name             String              @unique
  targetHouseholds Int                 @default(0)
  mapX             Float               @default(50)
  mapY             Float               @default(50)
  active           Boolean             @default(true)
  households       Household[]
  assignments      ClusterAssignment[]
  createdAt        DateTime            @default(now())
}

model ClusterAssignment {
  id        String  @id @default(uuid())
  userId    String
  clusterId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cluster   Cluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@unique([userId, clusterId])
}

model Household {
  id                  String     @id @default(uuid())
  clusterId           String
  cluster             Cluster    @relation(fields: [clusterId], references: [id])
  /// Survey code shown everywhere, e.g. M2S-001245
  code                String     @unique
  headName            String?
  assignedVolunteerId String?
  survey              Survey?
  documents           Document[]
  createdAt           DateTime   @default(now())
}

/// Full questionnaire definition (questions, option codes, labels) stored as JSON.
model QuestionnaireVersion {
  id           String   @id @default(uuid())
  version      Int      @unique
  definition   Json
  sourceSha256 String
  surveys      Survey[]
  createdAt    DateTime @default(now())
}

model Survey {
  /// Client-generated UUID so surveys can be created offline.
  id                     String               @id
  householdId            String               @unique
  volunteerId            String
  questionnaireVersionId String
  status                 SurveyStatus         @default(DRAFT)
  revision               Int                  @default(1)
  consentGiven           Boolean              @default(false)
  gpsConsent             Boolean              @default(false)
  gpsLat                 Float?
  gpsLng                 Float?
  gpsAccuracyMeters      Float?
  gpsCapturedAt          DateTime?
  gpsPermissionStatus    String?
  submittedIp            String?
  submittedIpLocation    String?
  startedAt              DateTime?
  durationSec            Int?
  /// Household profile B1–B12 (see web HouseholdProfile type)
  profile                Json
  household              Household            @relation(fields: [householdId], references: [id])
  volunteer              User                 @relation(fields: [volunteerId], references: [id])
  questionnaireVersion   QuestionnaireVersion @relation(fields: [questionnaireVersionId], references: [id])
  answers                Answer[]
  reviews                ReviewAction[]
  qualityResolutions     SurveyQualityResolution[]
  qualityEvents          SurveyQualityEvent[]
  submittedAt            DateTime?
  updatedAt              DateTime             @updatedAt
  createdAt              DateTime             @default(now())

  @@index([status])
  @@index([volunteerId])
}

/// questionId e.g. "Q12"; optionCodes keeps CODES (never labels). optionKeys are UI-unique keys.
model Answer {
  id          String   @id @default(uuid())
  surveyId    String
  questionId  String
  optionCodes String[]
  optionKeys  String[]
  otherText   String?
  survey      Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, questionId])
}

model ReviewAction {
  id         String         @id @default(uuid())
  surveyId   String
  reviewerId String
  decision   ReviewDecision
  reason     String
  survey     Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  createdAt  DateTime       @default(now())
}

/// Persistent resolution state per survey & validation rule (supports snapshot staleness checks & supervisor queue).
model SurveyQualityResolution {
  id               String    @id @default(uuid())
  surveyId         String
  ruleId           String
  ruleVersion      String
  status           String
  note             String?
  verifiedById     String?
  verifiedByName   String?
  verifiedAt       DateTime?
  answerSnapshot   Json?
  supervisorStatus String?
  supervisorNote   String?
  reviewedById     String?
  reviewedByName   String?
  reviewedAt       DateTime?
  clientEventId    String?
  survey           Survey    @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([surveyId, ruleId])
  @@index([status])
  @@index([supervisorStatus])
}

/// Append-only validation history & override audit log with clientEventId deduplication for offline sync.
model SurveyQualityEvent {
  id               String   @id @default(uuid())
  surveyId         String
  ruleId           String
  ruleTitle        String
  severity         String
  eventType        String
  status           String
  actorId          String?
  actorName        String?
  actorRole        String?
  note             String?
  previousAnswers  Json?
  updatedAnswers   Json?
  supervisorStatus String?
  clientEventId    String
  survey           Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([surveyId, clientEventId])
  @@index([surveyId, createdAt])
}

model Document {
  id                 String             @id @default(uuid())
  householdId        String
  household          Household          @relation(fields: [householdId], references: [id])
  categoryId         String
  docType            String
  aadhaarLast4       String? /// never full Aadhaar
  consentConfirmed   Boolean            @default(false)
  status             DocStatus          @default(UPLOADING)
  verificationStatus VerificationStatus @default(PENDING)
  rejectionReason    String?
  uploadedById       String
  uploadedBy         User               @relation("DocUploader", fields: [uploadedById], references: [id])
  verifiedById       String?
  verifiedBy         User?              @relation("DocVerifier", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  pages              DocumentPage[]
  createdAt          DateTime           @default(now())

  @@index([householdId])
}

model DocumentPage {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  objectKey  String   @unique /// random key; bytes live in private storage
  fileName   String
  mime       String
  sizeBytes  Int
  sha256     String
  pageNo     Int
}

model SyncRecord {
  idempotencyKey String   @id
  userId         String
  surveyId       String
  result         Json
  createdAt      DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  summary   String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
