# M2S Volunteer Mobile App Environment Example
# Production builds must point to an HTTPS NestJS API origin (no trailing slash).
# Example production API URL:
VITE_API_ORIGIN=https://api.example.org

# For local Android Emulator testing only (points Android Emulator to host PC port 3000),
# pass VITE_API_ORIGIN=http://10.0.2.2:3000 at dev/emulator build time or enter it in
# the in-app "API Server Configuration" screen (never hardcode dev IPs in release builds).

